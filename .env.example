# Configuration pour l'API France Travail
# Obtenez vos credentials sur: https://francetravail.io/produits-partages/catalogue

# API Credentials (obligatoire)
FRANCETRAVAIL_CLIENT_ID=votre_client_id_ici
FRANCETRAVAIL_CLIENT_SECRET=votre_client_secret_ici

# Configuration Base de Données (optionnel - défaut: SQLite local)
DATABASE_URL=sqlite:///./data/emploi_store.db

# Configuration API (optionnel)
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Configuration Logging
LOG_LEVEL=INFO
